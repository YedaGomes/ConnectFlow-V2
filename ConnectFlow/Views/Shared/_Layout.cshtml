<!DOCTYPE html>
<html lang="pt-br" style="scroll-behavior: smooth; scroll-padding-top: 110px;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ConnectFlow</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ConnectFlow.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/images/Flaticon.png" />

</head>
   <body style="margin: 0; padding: 0; display: flex; flex-direction: column; min-height: 100vh; background-color: #0b0f19;">    
       <header style="position: fixed !important; top: 0; left: 0; width: 100%; z-index: 99999; background-color: #0b0f19; height: 110px; border-bottom: 1px solid #1f2937; display: flex; justify-content: space-between; align-items: center; padding: 0 5%;">
        <div class="logo_pim">
            <a href="@Url.Action("Index", "Home")">
                <img src="~/images/Logo.png" alt="Logo" style="max-height: 75px !important; width: auto; display: block;" />
            </a>
        </div>
        <nav>
            <ul style="list-style: none; display: flex; gap: 30px; margin: 0; padding: 0;">
                <li><a href="@Url.Action("Index", "Home")#servicos" style="color: #ffffff; text-decoration: none; font-weight: 600; font-family: 'Montserrat', sans-serif; font-size: 1.15rem !important;">Soluções</a></li>
                <li><a href="@Url.Action("Index", "Home")#sobre-nos" style="color: #ffffff; text-decoration: none; font-weight: 600; font-family: 'Montserrat', sans-serif; font-size: 1.15rem !important;">Sobre Nós</a></li>
                <li><a href="@Url.Action("Create", "Clientes")" style="color: #ffffff; text-decoration: none; font-weight: 600; font-family: 'Montserrat', sans-serif; font-size: 1.15rem !important;">Solicitar Integração</a></li>
                <li><a class="btn-acompanhar" href="@Url.Action("Login", "Home")" style="font-family: 'Montserrat', sans-serif; font-size: 0.9rem !important; text-decoration: none;">Acompanhar Solicitação</a></li>
            </ul>
        </nav>
    </header>

    <main role="main" style="flex: 1;">
        @RenderBody()
    </main>

    <footer style="background-color: #0b0f19; width: 100%; padding: 20px 0; text-align: center; border-top: 1px solid #1f2937; margin-top: auto;">
        <p style="margin: 0; color: #9ca3af; font-family: 'Montserrat', sans-serif; font-size: 0.9rem;">
            &copy; 2026 ConnectFlow Solutions - Todos os direitos reservados |
            <a href="/Creditos" style="color: #60a5fa; text-decoration: none;">Créditos de Imagens</a>
        </p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)

    <div vw class="enabled">
        <div vw-access-button class="active"></div>
        <div vw-plugin-wrapper>
            <div class="vw-plugin-top-wrapper"></div>
        </div>
    </div>
     <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
    <script>
        new window.VLibras.Widget('https://vlibras.gov.br/app');
    </script>

</body>
</html>


