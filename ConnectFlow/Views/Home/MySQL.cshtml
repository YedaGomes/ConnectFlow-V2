@{
    Layout = null;
}
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "MySQL";
}
<div class="conteudo-da-solucao">
</div>

<style>

    .hero-solucao {
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
        border-bottom: 1px solid #1e293b;
        padding: 80px 0;
    }

    .hero-titulo {
        font-size: 2.8rem;
        font-weight: 800;
        line-height: 1.2;
        margin-bottom: 20px;
        color: #ffffff;
    }

    .hero-subtitulo {
        font-size: 1.25rem;
        color: #93c5fd;
        line-height: 1.6;
        margin-bottom: 30px;
    }

    .img-fluid-hero {
        max-width: 100%;
        height: auto;
        border-radius: 12px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
    }

    .recursos-section {
        padding: 80px 0;
    }

    .recurso-bloco {
        display: flex;
        align-items: center;
        margin-bottom: 100px;
    }

        .recurso-bloco:last-child {
            margin-bottom: 0;
        }

    .recurso-texto {
        padding: 20px;
    }

    .recurso-badge {
        background-color: #1e293b;
        color: #38bdf8;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-block;
        margin-bottom: 15px;
        border: 1px solid #334155;
    }

    .recurso-titulo {
        font-size: 1.8rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 15px;
    }

    .recurso-descricao {
        color: #94a3b8;
        font-size: 1.1rem;
        line-height: 1.7;
    }

    .img-recurso {
        width: 100%;
        max-width: 450px;
        border-radius: 16px;
        border: 1px solid #1e293b;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2);
    }

    .cta-section {
        background-color: #0f172a;
        padding: 60px 0;
        text-align: center;
        border-top: 1px solid #1e293b;
    }

    .btn-solicitar {
        background: linear-gradient(135deg, #38bdf8, #2563eb);
        color: white !important;
        font-weight: 700;
        font-size: 1.2rem;
        border: none;
        border-radius: 8px;
        padding: 16px 45px;
        text-decoration: none;
        display: inline-block;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        box-shadow: 0 4px 14px 0 rgba(37, 99, 235, 0.4);
        cursor: pointer;
    }

        .btn-solicitar:hover {
            transform: scale(1.03);
            box-shadow: 0 6px 20px 0 rgba(37, 99, 235, 0.6);
        }

    .modal-content-custom {
        background-color: #1e293b !important;
        border: 1px solid #334155 !important;
        color: #ffffff !important;
        border-radius: 16px !important;
    }

    .modal-header-custom {
        border-bottom: 1px solid #334155 !important;
    }

    .modal-footer-custom {
        border-top: 1px solid #334155 !important;
    }

    .form-control,
    input.form-control,
    textarea.form-control {
        background-color: #ffffff !important;
        color: #000000 !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 8px;
        padding: 12px;
    }

        .form-control:focus,
        input.form-control:focus,
        textarea.form-control:focus {
            background-color: #ffffff !important;
            color: #000000 !important;
            border-color: #38bdf8 !important;
            box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.2) !important;
        }

        .form-control::placeholder {
            color: #555555 !important;
            opacity: 1 !important;
        }
</style>

<main style="background-color: #0b111e; min-height: 100vh;">
    <section class="hero-solucao">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <h1 class="hero-titulo">Integração Inteligente com Banco de Dados</h1>
                    <p class="hero-subtitulo">
                        Estruturamos e conectamos bancos de dados robustos para garantir máxima performance, total segurança e escalabilidade para o armazenamento das informações da sua empresa.
                    </p>
                    <button class="btn-solicitar" data-bs-toggle="modal" data-bs-target="#modalContato">Fale com um Especialista</button>
                </div>
                <div class="col-lg-6 text-center mt-4 mt-lg-0">
                    <img src="~/images/IntegraçãoMySQL.jpg" alt="Painel MySQL ConnectFlow" class="img-fluid-hero" onerror="this.src='https://placehold.co/600x400/1e3a8a/ffffff?text=Painel+MySQL'" />
                </div>
            </div>
        </div>
    </section>

    <section class="recursos-section">
        <div class="container">
            <div class="row recurso-bloco align-items-center mb-5">
                <div class="col-md-6 text-center order-2 order-md-1">
                    <div class="tech-image-container">
                        <img src="~/images/AnaliseDados.jpg" alt="Modelagem de Dados" class="img-recurso" onerror="this.src='https://placehold.co/450x300/111827/ffffff?text=Modelagem+de+Dados'" />
                    </div>
                    <hr class="recurso-divisor" />
                </div>
                <div class="col-md-6 order-1 order-md-2">
                    <div class="recurso-texto">
                        <span class="recurso-badge">Performance</span>
                        <h2 class="recurso-titulo">Modelagem de dados otimizada</h2>
                        <p class="recurso-descricao">
                            Desenvolvemos arquiteturas de tabelas perfeitamente indexadas e relacionamentos inteligentes para garantir consultas rápidas e instantâneas, eliminando lentidões mesmo com grandes volumes de dados.
                        </p>
                    </div>
                </div>
            </div>
            <hr class="recurso-divisor" />
            <div class="row recurso-bloco align-items-center mb-5">
                <div class="col-md-6">
                    <div class="recurso-texto">
                        <span class="recurso-badge">Segurança</span>
                        <h2 class="recurso-titulo">Sincronização e Prevenção</h2>
                        <p class="recurso-descricao">
                            Implementamos rotinas automáticas de backup e espelhamento de dados em tempo real. Sua empresa fica protegida de ponta a ponta contra perdas críticas ou falhas operacionais involuntárias.
                        </p>
                    </div>
                </div>
                <div class="col-md-6 text-center">
                    <div class="tech-image-container">
                        <img src="~/images/Segurança.jpg" alt="Segurança de Dados" class="img-recurso" onerror="this.src='https://placehold.co/450x300/111827/ffffff?text=Seguranca+e+Backups'" />
                    </div>
                </div>
            </div>
            <hr class="recurso-divisor" />
            <div class="row recurso-bloco align-items-center">
                <div class="col-md-6 text-center order-2 order-md-1">
                    <div class="tech-image-container">
                        <img src="~/images/Escalabilidade1.jpg" alt="Escalabilidade" class="img-recurso" onerror="this.src='https://placehold.co/450x300/111827/ffffff?text=Escalabilidade'" />
                    </div>
                </div>
                <div class="col-md-6 order-1 order-md-2">
                    <div class="recurso-texto">
                        <span class="recurso-badge">Nuvem & Infra</span>
                        <h2 class="recurso-titulo">Pronto para a Escalabilidade</h2>
                        <p class="recurso-descricao">
                            Esqueça gargalos na sua operação. Nossa estrutura prepara seu ambiente de dados para suportar o crescimento progressivo no volume de acessos concorrentes sem perder estabilidade.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="cta-section">
        <div class="container">
            <h3 class="mb-4">Pronto para transformar a gestão de dados do seu negócio?</h3>
            <button class="btn-solicitar" data-bs-toggle="modal" data-bs-target="#modalContato">Fale com um Especialista</button>
        </div>
    </section>
</main>

<div class="modal fade" id="modalContato" tabindex="-1" aria-labelledby="modalContatoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-custom">
            <div class="modal-header modal-header-custom">
                <h5 class="modal-title" id="modalContatoLabel">Central de Dúvidas - ConnectFlow</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formDuvidaContato">
                <div class="modal-body">
                    <p style="color: #94a3b8; font-size: 0.95rem; margin-bottom: 20px;">
                        Preencha os campos abaixo para enviar sua mensagem para nossa equipe. Responderemos em breve!
                    </p>
                    <div class="mb-3">
                        <label class="form-label">Nome Completo</label>
                        <input type="text" id="nomeApi" class="form-control" placeholder="Digite seu nome" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">E-mail Corporativo</label>
                        <input type="email" id="emailApi" class="form-control" placeholder="seu-email@empresa.com" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mensagem</label>
                        <textarea id="msgApi" class="form-control" rows="3" placeholder="Dúvida sobre REST, SOAP ou Webhooks?" required></textarea>
                    </div>
                </div>
                <div class="modal-footer modal-footer-custom">
                    <button type="submit" class="btn" style="background: linear-gradient(135deg, #38bdf8, #2563eb); color: white; font-weight: 600; border-radius: 8px; padding: 12px 24px; width: 100%;">Enviar Mensagem</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>

    $(document).ready(function () {
        $("#formDuvidaContato").on("submit", function (e) {
            e.preventDefault();

            var nomeUsuario = $("#nomeApi").val(); 

            alert("Obrigado pelo contato, " + nomeUsuario + "!\nSua mensagem foi enviada com sucesso para nossa Central de Dúvidas.");

            this.reset();

            var modalElement = document.getElementById('modalContato');
            var modalInstance = bootstrap.Modal.getInstance(modalElement);
            modalInstance.hide();
        });
    });
</script>