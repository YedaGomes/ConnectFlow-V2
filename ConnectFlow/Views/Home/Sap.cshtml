@{
    Layout = null;
}
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Automação SAP";
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Integração SAP - ConnectFlow</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
                        body {
                            background-color: #0b111e;
                            color: #ffffff;
                            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                            min-height: 100vh;
                            display: flex;
                            flex-direction: column;
                            margin: 0;
                        }

          
                        .meu-header-personalizado {
                            width: 100%;
                            padding: 20px 50px;
                            display: flex;
                            justify-content: space-between;
                            align-items: center;
                            border-bottom: 1px solid #1e293b;
                            background-color: #0b111e;
                        }

                        .logo-marca {
                            font-size: 1.5rem;
                            font-weight: bold;
                            color: #ffffff;
                            text-decoration: none;
                        }

                        .meu-menu a {
                            color: #94a3b8;
                            text-decoration: none;
                            margin-left: 25px;
                            font-size: 0.95rem;
                            transition: color 0.3s;
                        }
                        .meu-menu a:hover {
                            color: #ffffff; 
                        }

           
                        .hero-solucao {
                            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
                            border-bottom: 1px solid #1e293b;
                            padding: 80px 0;
                        }

                        .hero-titulo {
                            font-size: 2.8rem;
                            font-weight: 800;
                            line-height: 1.2;
                            margin-bottom: 20px;
                            color: #ffffff;
                        }

                        .hero-subtitulo {
                            font-size: 1.25rem;
                            color: #93c5fd;
                            line-height: 1.6;
                            margin-bottom: 30px;
                        }

                        .img-fluid-hero {
                            max-width: 100%;
                            height: auto;
                            border-radius: 12px;
                            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
                        }

       
                        .recursos-section {
                            padding: 80px 0;
                        }

                        .recurso-bloco {
                            display: flex;
                            align-items: center;
                            margin-bottom: 100px;
                        }

                        .recurso-bloco:last-child {
                            margin-bottom: 0;
                        }

                        .recurso-texto {
                            padding: 20px;
                        }

                        .recurso-badge {
                            background-color: #1e293b;
                            color: #38bdf8;
                            padding: 6px 16px;
                            border-radius: 20px;
                            font-size: 0.85rem;
                            font-weight: 600;
                            margin-bottom: 15px;
                            display: inline-block;
                            border: 1px solid #334155;
                            text-transform: uppercase;
                            letter-spacing: 0.5px;
                        }

                        .recurso-titulo {
                            font-size: 1.8rem;
                            font-weight: 700;
                            color: #ffffff;
                            margin-bottom: 15px;
                        }

                        .recurso-descricao {
                            color: #94a3b8;
                            font-size: 1.1rem;
                            line-height: 1.7;
                        }

                        .img-recurso {
                            width: 100%;
                            max-width: 450px;
                            border-radius: 16px;
                            border: 1px solid #1e293b;
                            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2);
                        }

                        .cta-section {
                            background-color: #0f172a;
                            padding: 60px 0;
                            text-align: center;
                            border-top: 1px solid #1e293b;
                        }

       
                        .btn-solicitar {
                            background: linear-gradient(135deg, #38bdf8, #2563eb);
                            color: white !important;
                            font-weight: 700;
                            font-size: 1.1rem;
                            border: none;
                            border-radius: 8px;
                            padding: 14px 35px;
                            cursor: pointer;
                            transition: transform 0.2s ease, box-shadow 0.2s ease;
                            display: inline-block;
                            text-decoration: none;
                            box-shadow: 0 4px 14px 0 rgba(37, 99, 235, 0.4);
                        }

                        .btn-solicitar:hover {
                            transform: translateY(-2px);
                            box-shadow: 0 6px 20px 0 rgba(37, 99, 235, 0.6);
                        }

                        .modal-customizado .modal-content {
                            background-color: #121824;
                            border: 1px solid #1e293b;
                            border-radius: 16px;
                        }

                        .modal-customizado .modal-header {
                            border-bottom: 1px solid #1e293b;
                            padding: 25px;
                        }

                        .modal-customizado .form-control {
                            background-color: #ffffff !important; 
                            border: 1px solid #ccc;
                            color: #000000 !important; 
                            border-radius: 8px;
                            padding: 12px;
                        }

                        .modal-customizado .form-control:focus {
                            background-color: #070a12;
                            border-color: #38bdf8;
                            color: #ffffff;
                            box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.2);
                        }

                        .modal-customizado .form-label {
                            color: #cbd5e1;
                            font-weight: 500;
                            margin-bottom: 8px;
                        }

            
                        footer {
                            text-align: center;
                            padding: 30px 0;
                            color: #64748b;
                            font-size: 0.85rem;
                            border-top: 1px solid #1e293b;
                            margin-top: auto;
                            background-color: #0b111e;
                        }
    </style>
</head>
<body>

    <section class="hero-solucao">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <h1 class="hero-titulo">Potencialize seu ERP SAP</h1>
                    <p class="hero-subtitulo">Conectamos seu ecossistema SAP a outras plataformas para automatizar processos financeiros, logísticos e de vendas, transformando dados em resultados estratégicos.</p>
                    <button class="btn-solicitar" data-bs-toggle="modal" data-bs-target="#modalAtendimento">Fale com um Especialista</button>
                </div>
                <div class="col-lg-6 text-center mt-4 mt-lg-0">
                    <img src="~/images/IntegraçãoERPInicial.jpg" alt="Painel Integração" class="img-fluid-hero" onerror="this.src='https://placehold.co/600x400/1e3a8a/ffffff?text=Integra%C3%A7%C3%A3o+SAP'" />
                </div>
            </div>
        </div>
    </section>

    <hr class="recurso-divisor" />

    <section class="recursos-section">
        <div class="container">
            <div class="row recurso-bloco align-items-center mb-5">
                <div class="col-md-6 text-center order-2 order-md-1">
                    <div class="tech-image-container">
                        <img src="~/images/Escalabilidade2.jpg" alt="Automação ERP" class="img-recurso" onerror="this.src='https://placehold.co/450x300/111827/ffffff?text=Automacao+ERP'" />
                    </div>
                </div>
                <div class="col-md-6 order-1 order-md-2">
                    <div class="recurso-texto">
                        <span class="recurso-badge">Eficiência</span>
                        <h2 class="recurso-titulo">Automação de Processos</h2>
                        <p class="recurso-descricao">Elimine a entrada manual de dados e o retrabalho na sua cadeia operacional. Nossas soluções integram pedidos, notas fiscais 
                            e controle de estoque diretamente no seu sistema, garantindo que a informação flua sem interrupções. Além de reduzir drasticamente os custos operacionais, 
                            esta automação garante que os dados estejam sempre atualizados e disponíveis para tomada de decisão, eliminando falhas de comunicação entre departamentos.</p>
                    </div>
                </div>
            </div>

            <hr class="recurso-divisor" />

            <div class="row recurso-bloco align-items-center mt-5">
                <div class="col-md-6">
                    <div class="recurso-texto">
                        <span class="recurso-badge">Visibilidade</span>
                        <h2 class="recurso-titulo">Inteligência de Negócio</h2>
                        <p class="recurso-descricao">Extraímos, tratamos e consolidamos dados do seu sistema central para gerar dashboards intuitivos em tempo real, permitindo uma visão 360º 
                            da saúde financeira e operacional. Com nossos indicadores inteligentes, você deixa de apenas observar números e passa a antecipar cenários. Entregamos a clareza 
                            necessária para que cada movimento do seu negócio seja guiado por dados precisos, impulsionando o crescimento sustentável e a competitividade no mercado.</p>
                    </div>
                </div>
                <div class="col-md-6 text-center">
                    <div class="tech-image-container">
                        <img src="~/images/AnaliseDados1.jpg" alt="Inteligência SAP" class="img-recurso" onerror="this.src='https://placehold.co/450x300/111827/ffffff?text=Inteligencia+SAP'" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="cta-section">
        <div class="container">
            <h4 class="mb-4">Sua empresa está pronta para o próximo nível com SAP?</h4>
            <button class="btn-solicitar" data-bs-toggle="modal" data-bs-target="#modalAtendimento">Fale com um Especialista</button>
        </div>
    </section>

    <div class="modal fade modal-customizado" id="modalAtendimento" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Central de Dúvidas - SAP</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="formSap">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Nome Completo</label>
                            <input type="text" id="nomeApi" class="form-control" placeholder="Digite seu nome" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">E-mail Corporativo</label>
                            <input type="email" id="emailApi" class="form-control" placeholder="seu-email@empresa.com" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mensagem</label>
                            <textarea id="msgApi" class="form-control" rows="3" placeholder="Dúvida sobre REST, SOAP ou Webhooks?" required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer" style="border:none;">
                        <button type="submit" class="btn-solicitar" style="width:100%;">Enviar Mensagem</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $("#formSap").on("submit", function (e) {
            e.preventDefault();
            alert("Obrigado, " + $("#nomeSap").val() + "!\nSua dúvida sobre SAP foi enviada com sucesso.");
            this.reset();
            bootstrap.Modal.getInstance(document.getElementById('modalAtendimento')).hide();
        });
    </script>
</body>
</html>