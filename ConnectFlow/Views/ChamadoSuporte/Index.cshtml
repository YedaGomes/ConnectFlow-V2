@model IEnumerable<ConnectFlow.Models.ChamadoSuporte>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Pesquisar por nome ou mensagem do chamado..." />
        <button type="submit" class="btn btn-primary">Pesquisar</button>
        <a asp-action="Index" class="btn btn-secondary">Limpar</a>
    </div>
</form>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IdCliente)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cliente)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NomeCompleto)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EmailCorporativo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Mensagem)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataEnvio)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.IdCliente)
            </td>
            <td>
                @Html.DisplayFor(model => item.Cliente)
            </td>
            <td>
                @Html.DisplayFor(model => item.NomeCompleto)
            </td>
            <td>
                @Html.DisplayFor(model => item.EmailCorporativo)
            </td>
            <td>
                @Html.DisplayFor(model => item.Mensagem)
            </td>
            <td>
                @Html.DisplayFor(model => item.DataEnvio)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdChamado">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdChamado">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdChamado">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
